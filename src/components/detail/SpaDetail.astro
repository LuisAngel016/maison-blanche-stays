---
import { spaTreatments, type Treatment } from '../../data/spa';
import { getDictionary, type Lang, useTranslations } from '../../i18n/utils';
import { getLocalizedPath } from '../../lib/routes';
import SmartImage from '../media/SmartImage.astro';
import TreatmentCard from '../cards/TreatmentCard.astro';

interface Props {
  lang: Lang;
  treatment: Treatment;
}

const { lang, treatment } = Astro.props;
const dict = getDictionary(lang);
const d = dict.spaDetail;
const t = useTranslations(lang);
const spaHref = getLocalizedPath(lang, 'spa');
const reserveHref = getLocalizedPath(lang, 'reserve');
const longText = treatment.long[lang];
const benefits = treatment.benefits[lang];
const includes = treatment.includes[lang];
const relatedTreatments = spaTreatments.filter((candidate) => candidate.slug !== treatment.slug).slice(0, 3);
---

<section class="bg-surface px-4 pb-14 pt-8 sm:px-6 md:px-8 md:pb-20 md:pt-12" data-animate>
  <div class="mx-auto max-w-7xl">
    <nav aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'} class="mb-8 flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.22em] text-secondary">
      <a href={spaHref} class="transition-colors hover:text-primary">{t('nav.spa')}</a>
      <span aria-hidden="true" class="text-outlineVariant">—</span>
      <span class="text-onBackground">{treatment.title[lang]}</span>
    </nav>

    <div class="grid gap-10 md:grid-cols-12 md:gap-16">
      <div class="flex flex-col justify-center md:col-span-5">
        <p class="mb-3 text-xs uppercase tracking-[0.28em] text-primary">{dict.pages.spa.eyebrow}</p>
        <h1 class="text-4xl font-headline leading-none text-onBackground sm:text-5xl md:text-6xl">{treatment.title[lang]}</h1>
        <p class="mt-5 max-w-md text-secondary">{treatment.description[lang]}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="pill">{treatment.duration}</span>
          <span class="pill">{treatment.price}</span>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-6">
          <a href={reserveHref} class="cta-button px-8 py-3 text-sm text-white">{d.reserve}</a>
          <a href={spaHref} class="editorial-link">{d.back}</a>
        </div>
      </div>
      <div class="md:col-span-7">
        <div class="card-media aspect-[4/3] rounded-3xl">
          <SmartImage
            src={treatment.image}
            alt={treatment.title[lang]}
            width={1400}
            height={1050}
            sizes="(min-width: 768px) 58vw, calc(100vw - 2rem)"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-surfaceContainerLow px-4 py-16 sm:px-6 md:px-8 md:py-24" data-animate>
  <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-7">
      <h2 class="mb-6 text-3xl font-headline sm:text-4xl">{dict.pages.spa.eyebrow}</h2>
      {longText.map((paragraph) => <p class="mt-4 text-secondary first:mt-0">{paragraph}</p>)}
    </div>
    <div class="md:col-span-5">
      <h2 class="mb-6 text-3xl font-headline sm:text-4xl">{d.benefits}</h2>
      <ul class="space-y-4">
        {benefits.map((entry) => (
          <li class="flex items-start gap-3 text-secondary">
            <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
            <span>{entry}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="bg-surface px-4 py-16 sm:px-6 md:px-8 md:py-24" data-animate>
  <div class="mx-auto max-w-7xl">
    <h2 class="mb-8 text-3xl font-headline sm:text-4xl">{d.includes}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {includes.map((entry, index) => (
        <article class="card-tonal rounded-2xl bg-surfaceContainerLow p-6">
          <p class="font-headline text-2xl italic text-primary" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
          <p class="mt-3 text-secondary">{entry}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-surfaceContainerLow px-4 py-16 sm:px-6 md:px-8 md:py-24" data-animate>
  <div class="mx-auto max-w-7xl">
    <h2 class="mb-10 text-3xl font-headline sm:text-4xl">{d.other}</h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" data-stagger>
      {relatedTreatments.map((related) => <TreatmentCard lang={lang} treatment={related} headingLevel="h3" />)}
    </div>
  </div>
</section>

<section class="bg-onBackground px-4 py-14 text-white sm:px-6 md:px-8 md:py-20" data-animate>
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
    <div>
      <h2 class="text-3xl font-headline sm:text-4xl">{dict.detail.reserveHeading}</h2>
      <p class="mt-2 text-sm text-white/70">{dict.detail.reserveNote}</p>
    </div>
    <a href={reserveHref} class="cta-button px-8 py-3 text-sm text-white">{d.reserve}</a>
  </div>
</section>
