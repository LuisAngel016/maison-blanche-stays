---
import { spaTreatments } from '../../data/spa';
import type { Lang } from '../../i18n/utils';
import TreatmentCard from '../cards/TreatmentCard.astro';

interface Props { lang: Lang; }

const { lang } = Astro.props;
---

<section class="px-4 py-16 sm:px-6 md:px-8" data-animate>
  <div class="mx-auto grid max-w-7xl gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3" data-stagger>
    {spaTreatments.map((treatment) => <TreatmentCard lang={lang} treatment={treatment} />)}
  </div>
</section>
