---
import { restaurantHighlights } from '../../data/restaurant';
import { type Lang, useTranslations } from '../../i18n/utils';
import { getLocalizedPath } from '../../lib/routes';
import SmartImage from '../media/SmartImage.astro';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = useTranslations(lang);
const restaurantHref = getLocalizedPath(lang, 'restaurant');
---

<section class="px-4 py-16 sm:px-6 md:px-8" data-animate>
  <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-2" data-stagger>
    {restaurantHighlights.map((item) => (
      <a
        href={`${restaurantHref}/${item.slug}`}
        class="card-editorial group overflow-hidden rounded-2xl bg-surfaceContainer"
      >
        <div class="card-media h-56 w-full">
          <SmartImage src={item.image} alt={item.cardTitle[lang]} width={1200} height={840} class="h-full w-full object-cover" />
        </div>
        <div class="p-10">
          <h2 class="mb-3 text-4xl font-headline">{item.cardTitle[lang]}</h2>
          <p class="text-secondary">{item.cardDescription[lang]}</p>
          <span class="editorial-link mt-5 inline-block">
            {t(`restaurantDetail.${item.id === 'chef' ? 'chefLink' : 'menuLink'}`)} <span class="card-arrow" aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
