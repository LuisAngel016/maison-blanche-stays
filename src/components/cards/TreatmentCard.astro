---
import type { Treatment } from '../../data/spa';
import { type Lang, useTranslations } from '../../i18n/utils';
import { getLocalizedPath } from '../../lib/routes';
import SmartImage from '../media/SmartImage.astro';

interface Props {
  lang: Lang;
  treatment: Treatment;
  headingLevel?: 'h2' | 'h3';
}

const { lang, treatment, headingLevel = 'h2' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
const href = `${getLocalizedPath(lang, 'spa')}/${treatment.slug}`;
---

<a href={href} class="card-editorial group flex flex-col overflow-hidden rounded-2xl bg-[#F3F1EE] shadow-editorial">
  <div class="card-media aspect-[3/2]">
    <SmartImage src={treatment.image} alt={treatment.title[lang]} width={1200} height={800} class="h-full w-full object-cover" />
  </div>
  <div class="flex flex-1 flex-col border border-t-0 border-[#E8E5E0] p-6">
    <Heading class="font-headline text-xl">{treatment.title[lang]}</Heading>
    <div class="mt-2 flex items-center justify-between">
      <span class="rounded-full border border-[#D7D2CA] px-3 py-1 text-xs">{treatment.duration}</span>
      <span class="font-headline text-lg text-primary">{treatment.price}</span>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-secondary">{treatment.description[lang]}</p>
    <span class="mt-3 inline-block text-sm text-primary">{t('spaDetail.view')} <span class="card-arrow" aria-hidden="true">→</span></span>
  </div>
</a>
