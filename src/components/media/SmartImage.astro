---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  sizes = '(min-width: 1024px) 33vw, 100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
  ...rest
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  sizes={sizes}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
  {...rest}
/>
