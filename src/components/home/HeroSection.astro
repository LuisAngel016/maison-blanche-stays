---
import { type Lang, useTranslations } from '../../i18n/utils';
import { getLocalizedPath } from '../../lib/routes';
import SmartImage from '../media/SmartImage.astro';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="min-h-screen bg-background pt-[72px]" data-animate>
  <div class="mx-auto grid max-w-7xl grid-cols-1 md:grid-cols-2">
    <div class="flex items-center px-8 py-20 md:px-14">
      <div>
        <h1 class="mb-8 text-6xl font-headline leading-[0.95] text-onBackground md:text-8xl">
          {t('hero.line1')}<br />
          <span class="font-normal italic">{t('hero.line2')}</span><br />
          {t('hero.line3')}
        </h1>
        <p class="mb-10 max-w-md text-secondary">{t('hero.subtitle')}</p>
        <div class="mb-14 flex flex-wrap gap-4">
          <a href={getLocalizedPath(lang, 'suites')} class="cta-button px-8 py-3 text-sm text-white">{t('hero.ctaPrimary')}</a>
          <a href={getLocalizedPath(lang, 'gallery')} class="rounded-full border border-outlineVariant px-8 py-3 text-sm text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white">{t('hero.ctaSecondary')}</a>
        </div>
        <div class="grid grid-cols-3 gap-6 text-center md:text-left">
          <div>
            <p class="text-2xl font-headline text-primary">18</p>
            <p class="text-[10px] uppercase tracking-[0.2em] text-secondary">{t('hero.statSuites')}</p>
          </div>
          <div>
            <p class="text-2xl font-headline text-primary">★ 4.9</p>
            <p class="text-[10px] uppercase tracking-[0.2em] text-secondary">{t('hero.statRating')}</p>
          </div>
          <div>
            <p class="text-2xl font-headline text-primary">1963</p>
            <p class="text-[10px] uppercase tracking-[0.2em] text-secondary">{t('hero.statEstablished')}</p>
          </div>
        </div>
      </div>
    </div>
    <div class="relative min-h-[560px] overflow-hidden rounded-2xl bg-surfaceContainer">
      <SmartImage
        src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=1400&q=85&fit=crop"
        alt={lang === 'es' ? 'Terraza principal del hotel Maison Blanche' : 'Maison Blanche main terrace'}
        width={1400}
        height={1600}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full rounded-2xl object-cover"
      />
    </div>
  </div>
</section>
