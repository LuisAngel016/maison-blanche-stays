---
import SmartImage from '../media/SmartImage.astro';

const awards = [
  { text: 'Condé Nast Traveler', sub: 'Top 100 Hotels 2024', img: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400&q=70&fit=crop' },
  { text: 'Forbes Travel Guide', sub: 'Five Star Award', img: 'https://images.unsplash.com/photo-1582268611958-ebfd161ef9cf?w=400&q=70&fit=crop' },
  { text: 'Michelin Guide 2024', sub: 'Recommended', img: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=400&q=70&fit=crop' },
  { text: 'Tatler Travel Awards', sub: 'Best Boutique Hotel', img: 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=400&q=70&fit=crop' },
];
---

<section class="overflow-hidden bg-[#18160F] py-3 sm:py-4" aria-label="Awards" data-animate>
  <div class="marquee-track flex w-max items-center gap-4 px-4 sm:gap-6 sm:px-6">
    {[...awards, ...awards].map((award) => (
      <div class="flex min-w-[240px] items-center gap-3 rounded-2xl bg-white/5 px-3 py-3 text-white/90 sm:min-w-[280px] sm:gap-4 sm:px-4">
        <SmartImage src={award.img} alt={award.text} width={96} height={96} sizes="48px" class="h-10 w-10 rounded-2xl object-cover sm:h-12 sm:w-12" />
        <div>
          <p class="text-xs uppercase tracking-[0.18em]">{award.text}</p>
          <p class="text-[10px] uppercase tracking-[0.2em] text-white/70">{award.sub}</p>
        </div>
        <span class="text-primary">✦</span>
      </div>
    ))}
  </div>
</section>
