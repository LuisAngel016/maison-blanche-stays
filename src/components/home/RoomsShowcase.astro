---
import { rooms } from '../../data/rooms';
import { type Lang, useTranslations } from '../../i18n/utils';
import RoomCard from '../cards/RoomCard.astro';

interface Props { lang: Lang; compact?: boolean; }

const { lang, compact = false } = Astro.props;
const t = useTranslations(lang);
const categories = [
  { key: 'all', label: t('rooms.all') },
  { key: 'suites', label: t('rooms.suites') },
  { key: 'habitaciones', label: t('rooms.rooms') },
  { key: 'villa', label: t('rooms.villa') },
] as const;
---

<section class:list={['bg-surface px-4 sm:px-6 md:px-8', compact ? 'py-16 md:py-20' : 'py-16 md:py-28']} data-animate data-room-showcase>
  <div class="mx-auto max-w-7xl">
    {!compact && (
      <div class="mb-14 text-center">
        <p class="mb-4 text-xs uppercase tracking-[0.28em] text-primary">{t('rooms.eyebrow')}</p>
        <h2 class="text-4xl font-headline text-onBackground sm:text-5xl md:text-6xl">{t('rooms.title')}</h2>
      </div>
    )}

    {!compact && (
      <div class="mb-12 flex flex-wrap justify-center gap-3">
        {categories.map((category, index) => (
          <button
            type="button"
            class="rounded-full px-5 py-2 text-sm transition-colors hover:bg-surfaceContainerHigh data-[active=true]:bg-primary data-[active=true]:text-white"
            data-tab={category.key}
            data-active={index === 0 ? 'true' : 'false'}
          >
            {category.label}
          </button>
        ))}
      </div>
    )}

    <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3" data-stagger>
      {rooms.map((room) => <RoomCard lang={lang} room={room} />)}
    </div>
  </div>
</section>

<script>
  import { initRoomShowcases } from '../../lib/browser/room-showcase';
  initRoomShowcases();
</script>
