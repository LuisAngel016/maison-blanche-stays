---
import type { Lang } from '../i18n/utils';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { getAlternatePath, getLocalizedPath, type RouteKey } from '../lib/routes';
import { pageSeo } from '../lib/site';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, route, title, description, image } = Astro.props;
const pathname = Astro.url.pathname;
const alternatePath = getAlternatePath(pathname, lang);
const seo = pageSeo[route][lang];
---

<BaseLayout
  lang={lang}
  title={title ?? seo.title}
  description={description ?? seo.description}
  pathname={pathname}
  alternatePath={alternatePath}
  image={image}
>
  <SiteHeader lang={lang} currentRoute={route} homeHref={getLocalizedPath(lang, 'home')} reserveHref={getLocalizedPath(lang, 'reserve')} switchHref={alternatePath} />

  <main class="pt-[72px]">
    <slot />
  </main>

  <SiteFooter lang={lang} />

  <script>
    import { initScrollAnimations } from '../lib/browser/animate-on-scroll';
    initScrollAnimations();
  </script>
</BaseLayout>
