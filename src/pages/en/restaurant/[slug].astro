---
import PageLayout from '../../../layouts/PageLayout.astro';
import RestaurantDetail from '../../../components/detail/RestaurantDetail.astro';
import { restaurantHighlights, type RestaurantHighlight } from '../../../data/restaurant';

export function getStaticPaths() {
  return restaurantHighlights.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props {
  item: RestaurantHighlight;
}

const { item } = Astro.props;
---

<PageLayout lang="en" route="restaurant" title={`${item.cardTitle.en} | Maison Blanche`} description={item.cardDescription.en} image={item.image}>
  <RestaurantDetail lang="en" item={item} />
</PageLayout>
