---
import PageLayout from '../../layouts/PageLayout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import TrustStrip from '../../components/home/TrustStrip.astro';
import RoomsShowcase from '../../components/home/RoomsShowcase.astro';
import PhilosophySection from '../../components/home/PhilosophySection.astro';
import ExperiencesSection from '../../components/home/ExperiencesSection.astro';
import TestimonialsSection from '../../components/home/TestimonialsSection.astro';
import BookingForm from '../../components/forms/BookingForm.astro';
---

<PageLayout lang="en" route="home">
  <HeroSection lang="en" />
  <TrustStrip />
  <RoomsShowcase lang="en" />
  <PhilosophySection lang="en" />
  <ExperiencesSection lang="en" />
  <TestimonialsSection lang="en" />
  <section class="bg-onBackground px-8 py-28 text-white" data-animate>
    <div class="mx-auto max-w-7xl">
      <BookingForm lang="en" variant="dark" />
    </div>
  </section>
</PageLayout>
