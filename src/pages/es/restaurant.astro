---
import PageLayout from '../../layouts/PageLayout.astro';
import RestaurantHighlights from '../../components/sections/RestaurantHighlights.astro';
import BookingForm from '../../components/forms/BookingForm.astro';
import { getDictionary } from '../../i18n/utils';

const d = getDictionary('es');
---

<PageLayout lang="es" route="restaurant">
  <section class="bg-surfaceContainerLow px-8 py-28" data-animate>
    <div class="mx-auto max-w-5xl text-center">
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-primary">{d.pages.restaurant.eyebrow}</p>
      <h1 class="text-6xl font-headline">{d.pages.restaurant.title}</h1>
      <p class="mt-4 text-secondary">{d.pages.restaurant.subtitle}</p>
    </div>
  </section>
  <RestaurantHighlights lang="es" />
  <section class="bg-onBackground px-8 py-28 text-white" data-animate>
    <div class="mx-auto max-w-7xl">
      <BookingForm lang="es" variant="dark" />
    </div>
  </section>
</PageLayout>
