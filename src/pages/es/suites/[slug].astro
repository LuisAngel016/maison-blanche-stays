---
import PageLayout from '../../../layouts/PageLayout.astro';
import RoomDetail from '../../../components/detail/RoomDetail.astro';
import { rooms, type Room } from '../../../data/rooms';

export function getStaticPaths() {
  return rooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

interface Props {
  room: Room;
}

const { room } = Astro.props;
---

<PageLayout lang="es" route="suites" title={`${room.nameEs} | Maison Blanche`} description={room.descEs} image={room.image}>
  <RoomDetail lang="es" room={room} />
</PageLayout>
