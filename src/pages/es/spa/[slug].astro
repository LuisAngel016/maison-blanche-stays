---
import PageLayout from '../../../layouts/PageLayout.astro';
import SpaDetail from '../../../components/detail/SpaDetail.astro';
import { spaTreatments, type Treatment } from '../../../data/spa';

export function getStaticPaths() {
  return spaTreatments.map((treatment) => ({ params: { slug: treatment.slug }, props: { treatment } }));
}

interface Props {
  treatment: Treatment;
}

const { treatment } = Astro.props;
---

<PageLayout lang="es" route="spa" title={`${treatment.title.es} | Maison Blanche`} description={treatment.description.es} image={treatment.image}>
  <SpaDetail lang="es" treatment={treatment} />
</PageLayout>
